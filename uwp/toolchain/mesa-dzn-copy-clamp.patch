diff --git a/src/microsoft/vulkan/dzn_cmd_buffer.c b/src/microsoft/vulkan/dzn_cmd_buffer.c
index 34790e4..3227505 100644
--- a/src/microsoft/vulkan/dzn_cmd_buffer.c
+++ b/src/microsoft/vulkan/dzn_cmd_buffer.c
@@ -2703,6 +2703,45 @@ dzn_cmd_buffer_copy_img_chunk(struct dzn_cmd_buffer *cmdbuf,
                    region.extent.width, region.extent.height, region.extent.depth);
       return;
    }
+
+   /* RPCS3 can ask for a copy that reaches past the end of a surface right after the
+    * resolution scale changes. Desktop drivers clip that silently; on the Xbox the
+    * out-of-range box makes Close() fail with E_INVALIDARG and the device is lost.
+    * Clip the region to both mip levels, and skip it when nothing is left. */
+   {
+      const VkExtent3D se = {
+         MAX2(1u, src->vk.extent.width >> region.srcSubresource.mipLevel),
+         MAX2(1u, src->vk.extent.height >> region.srcSubresource.mipLevel),
+         MAX2(1u, src->vk.extent.depth >> region.srcSubresource.mipLevel),
+      };
+      const VkExtent3D de = {
+         MAX2(1u, dst->vk.extent.width >> region.dstSubresource.mipLevel),
+         MAX2(1u, dst->vk.extent.height >> region.dstSubresource.mipLevel),
+         MAX2(1u, dst->vk.extent.depth >> region.dstSubresource.mipLevel),
+      };
+      const VkExtent3D want = region.extent;
+      int64_t w = want.width, h = want.height, d = want.depth;
+      w = MIN2(MIN2(w, (int64_t)se.width - region.srcOffset.x), (int64_t)de.width - region.dstOffset.x);
+      h = MIN2(MIN2(h, (int64_t)se.height - region.srcOffset.y), (int64_t)de.height - region.dstOffset.y);
+      if (src->vk.image_type == VK_IMAGE_TYPE_3D)
+         d = MIN2(d, (int64_t)se.depth - region.srcOffset.z);
+      if (dst->vk.image_type == VK_IMAGE_TYPE_3D)
+         d = MIN2(d, (int64_t)de.depth - region.dstOffset.z);
+      if (w != want.width || h != want.height || d != want.depth) {
+         static unsigned count;
+         if (count++ < 8)
+            mesa_logw("dzn: clipping image copy %ux%ux%u src (%d,%d,%d) of %ux%u dst (%d,%d,%d) of %ux%u",
+                      want.width, want.height, want.depth,
+                      region.srcOffset.x, region.srcOffset.y, region.srcOffset.z, se.width, se.height,
+                      region.dstOffset.x, region.dstOffset.y, region.dstOffset.z, de.width, de.height);
+         if (w <= 0 || h <= 0 || d <= 0)
+            return;
+         region.extent.width = (uint32_t)w;
+         region.extent.height = (uint32_t)h;
+         region.extent.depth = (uint32_t)d;
+      }
+   }
+
    dzn_image_align_extent(src, &region.extent);
 
    const VkImageSubresourceLayers *src_subres = &region.srcSubresource;
